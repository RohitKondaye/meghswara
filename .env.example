# Copy to .env and fill in. Never commit .env (the repo is public).

# Google OAuth 2.0 Web Client ID (Google Cloud Console → APIs & Services → Credentials)
VITE_GOOGLE_CLIENT_ID=

# Private key for reading/clearing production telemetry (npm run logs).
# Must match the Cloudflare Pages secret of the same name.
TELEMETRY_READ_KEY=

# Optional: only if a tool/MCP server needs a GitHub token. Prefer `gh auth login` instead.
GITHUB_TOKEN=
